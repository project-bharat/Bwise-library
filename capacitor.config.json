{
  "appId": "com.bharatrasve.bwiselibrary",
  "appName": "B-wise Library",
  "webDir": "dist",
  "server": { "androidScheme": "https" },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": false,
      "backgroundColor": "#1E3535",
      "showSpinner": false
    },
    "StatusBar": { "style": "DARK", "backgroundColor": "#1E3535", "overlaysWebView": false }
  }
}
